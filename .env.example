# ---- Backend (all optional) ----
# Enables the LLM planner + narrator. Leave empty for deterministic mode (fully functional).
ANTHROPIC_API_KEY=
# auto | anthropic | none
FD_LLM_PROVIDER=auto
FD_LLM_MODEL=claude-opus-5-5
FD_CORS_ORIGINS=http://localhost:3000
FD_SQL_ROW_LIMIT=500
FD_SQL_TIMEOUT_S=5
# ---- Frontend ----
# Where Next.js proxies /api/* to
BACKEND_URL=http://127.0.0.1:8000
